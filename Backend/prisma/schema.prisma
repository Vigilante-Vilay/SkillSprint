
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum userRole{
  STUDENT
  INSTRUCTOR
}

model User{
  id        Int @id @default(autoincrement())
  firstName String
  lastName  String?
  email     String @unique
  role      userRole @default(STUDENT)
  password  String  
  courses   Course[]
  enrollments Enrollment[]
  payments   Payment[]
}

model PendingUser{
  id        Int @id @default(autoincrement())
  firstName String
  lastName  String?
  email     String @unique
  role      userRole @default(STUDENT)
  password  String
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())
}


model Course{
  id        Int @id @default(autoincrement())
  title     String
  description String
  price     Float
  thumbnail String
  instructorId Int

  instructor User @relation(fields: [instructorId], references: [id])
  enrollments Enrollment[]
  payments   Payment[]
}


model Enrollment{
  id        Int @id @default(autoincrement())
  studentId Int
  courseId  Int
  enrolledAt  DateTime @default(now())


  student User @relation(fields: [studentId], references: [id])
  course Course @relation(fields: [courseId], references: [id])
  @@unique([studentId,courseId])
}

enum paymentStatus{
  PENDING
  SUCCESS
  FAILED
}

model Payment{
  id        Int @id @default(autoincrement())
  studentId Int
  courseId  Int

  razorpayOrderId  String @unique
  razorpayPaymentId String? @unique

  amount    Int
  status    paymentStatus @default(PENDING)
  createdAt DateTime @default(now())

  student   User @relation(fields: [studentId], references: [id]) 
  course    Course @relation(fields: [courseId], references: [id]) 
}
